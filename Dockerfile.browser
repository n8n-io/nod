FROM node:24.21.0-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium xvfb xauth xdotool ffmpeg fonts-liberation ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci && npm cache clean --force
COPY src ./src
RUN chmod 555 src/providers/container-browser/chromium.sh && mkdir /data && chown node:node /data && chmod 700 /data
USER node
CMD ["node", "--import", "tsx", "/app/src/providers/container-browser/worker.ts"]
