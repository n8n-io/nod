FROM node:24.21.0-bookworm-slim AS dependencies
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN corepack enable && pnpm install --frozen-lockfile

FROM node:24.21.0-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium xvfb xauth xdotool ffmpeg fonts-liberation fonts-noto-core fonts-noto-cjk fonts-noto-color-emoji ca-certificates python3 tini \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=dependencies /app/package.json /app/pnpm-lock.yaml /app/pnpm-workspace.yaml ./
COPY --from=dependencies /app/node_modules ./node_modules
COPY src/ports/computer.ts src/ports/thread-identity.ts ./src/ports/
COPY src/shared/browser-errors.ts src/shared/browser-handoff.ts src/shared/files.ts ./src/shared/
COPY src/providers/process.ts ./src/providers/
COPY src/providers/agent-browser ./src/providers/agent-browser/
COPY src/providers/container-browser/worker.ts src/providers/container-browser/bridge.ts src/providers/container-browser/protocol.ts src/providers/container-browser/config.ts ./src/providers/container-browser/
COPY --chmod=555 src/providers/container-browser/chromium.sh ./src/providers/container-browser/
COPY --chmod=555 src/providers/container-browser/xvfb.sh /usr/local/bin/Xvfb
RUN mkdir -p /data /opt/otto && chown node:node /data && chmod 700 /data
COPY src/providers/cloudflare-computer/entrypoint.mjs /opt/otto/entrypoint.mjs
COPY src/providers/cloudflare-computer/checkpoint.py /opt/otto/checkpoint.py
RUN chmod 555 /opt/otto && chmod 444 /opt/otto/*
USER node
EXPOSE 4311
ENTRYPOINT ["/usr/bin/tini", "--", "node", "/opt/otto/entrypoint.mjs"]
CMD ["browser"]
