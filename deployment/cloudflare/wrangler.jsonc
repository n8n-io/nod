{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "otto",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "../../dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/runtime/*", "/__otto/*"],
  },
  "observability": {
    "enabled": false,
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GatewayContainer", "TenantContainer"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["BrowserComputerContainer", "WorkspaceComputerContainer"],
    },
  ],
  "env": {
    "development": {
      "name": "otto-development",
      "vars": {
        "OTTO_ENVIRONMENT": "development",
        "OTTO_PUBLIC_URL": "https://otto-development.n8n-maintenance.workers.dev",
      },
      "triggers": {
        "crons": ["* * * * *"],
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "GATEWAY",
            "class_name": "GatewayContainer",
          },
          {
            "name": "TENANTS",
            "class_name": "TenantContainer",
          },
          {
            "name": "BROWSER_COMPUTERS",
            "class_name": "BrowserComputerContainer",
          },
          {
            "name": "WORKSPACE_COMPUTERS",
            "class_name": "WorkspaceComputerContainer",
          },
        ],
      },
      "r2_buckets": [
        {
          "binding": "TENANT_FILES",
          "bucket_name": "otto-development-files",
          "jurisdiction": "eu",
        },
      ],
      "containers": [
        {
          "class_name": "GatewayContainer",
          "image": "./Dockerfile",
          "image_build_context": "../..",
          "instance_type": "basic",
          "max_instances": 1,
          "constraints": {
            "jurisdiction": "eu",
          },
          "rollout_step_percentage": 100,
          "rollout_active_grace_period": 60,
          "observability": {
            "logs": {
              "enabled": false,
            },
          },
        },
        {
          "class_name": "TenantContainer",
          "image": "./Dockerfile",
          "image_build_context": "../..",
          "instance_type": "basic",
          "max_instances": 8,
          "constraints": {
            "jurisdiction": "eu",
          },
          "rollout_step_percentage": 100,
          "rollout_active_grace_period": 60,
          "observability": {
            "logs": {
              "enabled": false,
            },
          },
        },
        {
          "class_name": "BrowserComputerContainer",
          "image": "./Dockerfile.browser",
          "image_build_context": "../..",
          "instance_type": "standard-4",
          "max_instances": 8,
          "constraints": {
            "jurisdiction": "eu",
          },
          "rollout_step_percentage": 100,
          "rollout_active_grace_period": 60,
          "observability": {
            "logs": {
              "enabled": false,
            },
          },
        },
        {
          "class_name": "WorkspaceComputerContainer",
          "image": "./Dockerfile.workspace",
          "image_build_context": "../..",
          "instance_type": "basic",
          "max_instances": 8,
          "constraints": {
            "jurisdiction": "eu",
          },
          "rollout_step_percentage": 100,
          "rollout_active_grace_period": 60,
          "observability": {
            "logs": {
              "enabled": false,
            },
          },
        },
      ],
    },
    "production": {
      "name": "otto",
      "vars": {
        "OTTO_ENVIRONMENT": "production",
        "OTTO_PUBLIC_URL": "https://otto.n8n-maintenance.workers.dev",
      },
      "triggers": {
        "crons": ["* * * * *"],
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "GATEWAY",
            "class_name": "GatewayContainer",
          },
          {
            "name": "TENANTS",
            "class_name": "TenantContainer",
          },
          {
            "name": "BROWSER_COMPUTERS",
            "class_name": "BrowserComputerContainer",
          },
          {
            "name": "WORKSPACE_COMPUTERS",
            "class_name": "WorkspaceComputerContainer",
          },
        ],
      },
      "r2_buckets": [
        {
          "binding": "TENANT_FILES",
          "bucket_name": "otto-production-files",
          "jurisdiction": "eu",
        },
      ],
      "containers": [
        {
          "class_name": "GatewayContainer",
          "image": "./Dockerfile",
          "image_build_context": "../..",
          "instance_type": "basic",
          "max_instances": 1,
          "constraints": {
            "jurisdiction": "eu",
          },
          "rollout_step_percentage": 100,
          "rollout_active_grace_period": 60,
          "observability": {
            "logs": {
              "enabled": false,
            },
          },
        },
        {
          "class_name": "TenantContainer",
          "image": "./Dockerfile",
          "image_build_context": "../..",
          "instance_type": "basic",
          "max_instances": 100,
          "constraints": {
            "jurisdiction": "eu",
          },
          "rollout_step_percentage": 100,
          "rollout_active_grace_period": 60,
          "observability": {
            "logs": {
              "enabled": false,
            },
          },
        },
        {
          "class_name": "BrowserComputerContainer",
          "image": "./Dockerfile.browser",
          "image_build_context": "../..",
          "instance_type": "standard-4",
          "max_instances": 100,
          "constraints": {
            "jurisdiction": "eu",
          },
          "rollout_step_percentage": 100,
          "rollout_active_grace_period": 60,
          "observability": {
            "logs": {
              "enabled": false,
            },
          },
        },
        {
          "class_name": "WorkspaceComputerContainer",
          "image": "./Dockerfile.workspace",
          "image_build_context": "../..",
          "instance_type": "basic",
          "max_instances": 100,
          "constraints": {
            "jurisdiction": "eu",
          },
          "rollout_step_percentage": 100,
          "rollout_active_grace_period": 60,
          "observability": {
            "logs": {
              "enabled": false,
            },
          },
        },
      ],
    },
  },
}
