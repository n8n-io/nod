FROM node:24.21.0-bookworm-slim AS helpers
WORKDIR /build
COPY src/providers/docker/command.ts ./src/providers/docker/command.ts
COPY src/providers/process.ts ./src/providers/process.ts
COPY src/ports/thread-identity.ts ./src/ports/thread-identity.ts
RUN node --experimental-transform-types --input-type=module -e 'import { writeFileSync } from "node:fs"; import { workspaceCommandProgram } from "./src/providers/docker/command.ts"; writeFileSync("/workspace-command.py", workspaceCommandProgram)'

FROM node:24.21.0-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python-is-python3 python3-pip python3-venv python3-requests python3-bs4 pipx ffmpeg poppler-utils jq tesseract-ocr tesseract-ocr-eng tesseract-ocr-deu tesseract-ocr-por tesseract-ocr-spa tesseract-ocr-fra ca-certificates curl git unzip ripgrep libreoffice-writer-nogui libreoffice-calc-nogui libreoffice-impress-nogui fonts-liberation fonts-crosextra-carlito fonts-crosextra-caladea fonts-noto-core fonts-noto-cjk fonts-noto-color-emoji qpdf ghostscript zip xz-utils file sqlite3 tesseract-ocr-cat tesseract-ocr-ita tesseract-ocr-nld tini \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/yt-dlp && /opt/yt-dlp/bin/pip install --no-cache-dir "yt-dlp[pin,pin-curl-cffi,pin-deno]==2026.8.19" && ln -s /opt/yt-dlp/bin/yt-dlp /usr/local/bin/yt-dlp
COPY --chmod=555 src/providers/docker/save-video.py /usr/local/bin/save-video
RUN python3 -m venv --system-site-packages /opt/otto-artifacts && /opt/otto-artifacts/bin/pip install --no-cache-dir reportlab==5.0.1 matplotlib==3.11.2 openpyxl==3.1.5 python-docx==1.2.0 python-pptx==1.0.2 pillow==12.3.0 pandas==3.0.6 pdfplumber==0.11.10 pillow-heif==1.8.0 pypdf==6.19.0 xlrd==2.0.2 odfpy==1.4.1 icalendar==7.3.0
RUN mkdir -p /opt/otto \
    && ln -s /home/node/state/workspace /workspace \
    && ln -s /home/node/state/tools /home/node/.local
RUN groupadd --gid 1002 otto-connected && useradd --uid 1002 --gid 1002 --create-home --shell /usr/sbin/nologin otto-connected && chmod 700 /home/otto-connected
COPY --from=helpers /workspace-command.py /opt/otto/workspace-command.py
COPY src/providers/cloudflare-computer/entrypoint.mjs /opt/otto/entrypoint.mjs
COPY src/providers/cloudflare-computer/checkpoint.py /opt/otto/checkpoint.py
RUN chmod 555 /opt/otto && chmod 444 /opt/otto/*
USER node
ENV LANG=C.UTF-8
ENV NPM_CONFIG_PREFIX=/home/node/.local
ENV PIPX_HOME=/home/node/.local/pipx
ENV PIPX_BIN_DIR=/home/node/.local/bin
ENV PATH=/opt/otto-artifacts/bin:/home/node/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WORKDIR /home/node
EXPOSE 4311
ENTRYPOINT ["/usr/bin/tini", "--", "node", "/opt/otto/entrypoint.mjs"]
CMD ["workspace"]
