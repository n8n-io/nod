---
import { Image, Picture } from 'astro:assets';
import '../styles/nod.css';
import n8nLogo from '../assets/landing/n8n-logo.svg?url';
import githubIcon from '../assets/landing/github.svg?url';
import appleIcon from '../assets/landing/apple.svg?url';
import windowsIcon from '../assets/landing/windows.svg?url';
import chatBubbleIcon from '../assets/landing/chat-bubble.svg?url';
import eyesIcon from '../assets/landing/eyes.svg?url';
import pencilComposeIcon from '../assets/landing/pencil-compose.svg?url';
import graduationCapIcon from '../assets/landing/graduation-cap.svg?url';
import downloadIcon from '../assets/landing/download.svg?url';
import heroCollage from '../assets/landing/hero-collage.webp';
import heroVideoPoster from '../assets/landing/hero-video-poster.png';
import demoAv1 from '../assets/video/nod-demo-1080.av1.mp4?url';
import demoAv1Small from '../assets/video/nod-demo-720.av1.mp4?url';
import demoHevc from '../assets/video/nod-demo-1080.hevc.mp4?url';
import demoHevcSmall from '../assets/video/nod-demo-720.hevc.mp4?url';
import demoH264 from '../assets/video/nod-demo-1080.h264.mp4?url';
import demoH264Small from '../assets/video/nod-demo-720.h264.mp4?url';
import briefCollage from '../assets/landing/brief-collage.png';
import replyCollage from '../assets/landing/reply-collage.png';
import watchCollage from '../assets/landing/watch-collage.png';
import socialImage from '../assets/landing/og.png';
import { gtmSnippet } from '../gtm.mjs';
import { formatStars } from '../scripts/star-count.js';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const github = 'https://github.com/n8n-io/nod';
const n8n = 'https://n8n.io';
const installGuide = `${base}get-started/install-desktop/`;
const benchmarkGuide = `${base}how-it-works/benchmarks/`;
const fonts = 'https://n8n.io/assets/fonts/baumer/variable';
const title = 'Nod · Your personal agent';
const description =
  'Nod is a personal agent that gets real-world jobs done. Open source, runs on Mac, Windows, Linux or your own server, with the model provider you choose.';
const url = 'https://nod.n8n.io/';
const image = new URL(socialImage.src, Astro.site);
const photo = { formats: ['webp'], fallbackFormat: 'jpg', quality: 80, alt: '', class: 'bg' } as const;
const stars = await fetch('https://api.github.com/repos/n8n-io/nod', { signal: AbortSignal.timeout(10_000) })
  .then((response) => (response.ok ? response.json() : null))
  .then((repo) => (Number.isInteger(repo?.stargazers_count) ? formatStars(repo.stargazers_count) : null))
  .catch(() => null);
const panelSizes = '(min-width: 1440px) 808px, (min-width: 1100px) 56vw, 92vw';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline set:html={gtmSnippet} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="n8n Labs" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="n8n logo above Nod, the open source personal agent with its own computer." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="theme-color" content="#fafafa" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}nod-touch-icon.png`} />
    <link rel="preconnect" href="https://n8n.io" crossorigin />
    <link rel="preload" href={`${fonts}/n8n-baumer-variable.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${fonts}/n8n-baumer-mono-variable.woff2`} as="font" type="font/woff2" crossorigin />
  </head>
  <body class="lp">
    <div class="lp-page">
      <header class="lp-header">
        <div class="lp-brand">
          <a class="lp-brand-logo" href={n8n} target="_blank" rel="noopener"
            ><img src={n8nLogo} alt="n8n" width="100" height="20" /></a
          >
          <span class="lp-brand-badge mono">Labs</span>
        </div>
        <div class="lp-header-right">
          <a class="lp-header-link mono" href={base}>Docs</a>
          <a class="lp-capsule lp-header-github gray-tertiary mono" href={github} target="_blank" rel="noopener"
            ><svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"
              ><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path></svg
            ><span>GitHub</span>{stars && <span class="lp-star-count">{stars}</span>}</a
          >
          <a class="lp-download-btn lp-header-download mono" href={installGuide} data-download>Download</a>
        </div>
      </header>

      <main class="lp-main">
      <section class="lp-hero">
        <div class="lp-hero-top">
          <span class="lp-hero-tag mono">Research preview</span>
          <div class="lp-hero-headline-frame lp-dot-grid-bg">
            <h1 class="lp-hero-headline">
              <span class="lp-hero-name"
                >Meet <span class="lp-sr">Nod</span><span class="lp-wordmark" aria-hidden="true"
                  >N<span class="lp-hero-glyph" id="heroGlyph"
                    ><svg viewBox="0 0 21 21" style="display:block;overflow:visible"
                      ><circle cx="9" cy="12" r="7.375" fill="none" stroke="#191919" stroke-width="3.25"></circle><g
                        class="lp-glyph-dot"><circle cx="17" cy="4" r="3.45" fill="#ff91ac"></circle></g
                      ></svg
                    ></span
                  >d</span
                ></span
              >
            </h1>
          </div>
          <p class="lp-hero-copy">
            Open source personal agent with its own computer. It chases invoices, preps your calls and cancels trials. On your machine, with
            your approval.
          </p>
          <div class="lp-hero-buttons">
              <div class="lp-cta-frame">
                <a class="lp-download-btn lp-download-btn-platform mono" href={installGuide} data-download="label"
                  ><img class="lp-btn-icon lp-os-icon mac" src={appleIcon} alt="" /><img
                    class="lp-btn-icon lp-os-icon windows"
                    src={windowsIcon}
                    alt=""
                  /><span data-download-label>Choose installer</span></a
                >
              </div>
              <div class="lp-cta-frame">
                <a class="lp-download-btn lp-download-btn-grey mono" href={github} target="_blank" rel="noopener"
                  ><img class="lp-btn-icon" src={githubIcon} alt="" />View the code</a
                >
              </div>
            </div>
          <p class="lp-hero-note">Free · Apache 2.0 · <a href={installGuide}>All install options</a></p>
        </div>

        <div class="lp-demo-photo">
          <Picture
            src={heroCollage}
            {...photo}
            widths={[640, 960, 1312, 2000]}
            sizes="(min-width: 1440px) 1312px, 92vw"
            loading="eager"
            fetchpriority="high"
          />
          <div class="lp-hero-video">
            <button type="button" class="lp-video-play" id="heroPlayBtn" aria-label="Play video">
              <Image
                src={heroVideoPoster}
                alt=""
                widths={[640, 960, 1280, 1920, 2560]}
                sizes="(min-width: 1440px) 1155px, 81vw"
                format="webp"
                quality={80}
                loading="eager"
              />
              <span class="lp-video-play-icon"><svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M5 2.5v11l9-5.5z"></path></svg></span>
            </button>
            <video id="heroVideo" controls playsinline preload="none" poster={heroVideoPoster.src} width="1920" height="1080" aria-label="Nod demo video" hidden>
              <source src={demoAv1Small} media="(max-width: 719px)" type='video/mp4; codecs="av01.0.05M.10, mp4a.40.2"' />
              <source src={demoAv1} type='video/mp4; codecs="av01.0.08M.10, mp4a.40.2"' />
              <source src={demoHevcSmall} media="(max-width: 719px)" type='video/mp4; codecs="hvc1.1.6.L93.B0, mp4a.40.2"' />
              <source src={demoHevc} type='video/mp4; codecs="hvc1.1.6.L120.B0, mp4a.40.2"' />
              <source src={demoH264Small} media="(max-width: 719px)" type="video/mp4" />
              <source src={demoH264} type="video/mp4" />
            </video>
          </div>
        </div>
      </section>

      <section class="lp-split">
        <div class="lp-split-intro">
          <div class="lp-hard-ones-frame wide with-sub lp-dot-grid-bg">
            <h2>No nod, no action</h2>
            <p class="lp-hard-ones-sub">In 678 test runs, Nod took zero actions without permission.</p>
          </div>
          <p class="lp-trust-stats-footnote"><a class="lp-stat-link" href={benchmarkGuide}>How we measured this</a></p>
        </div>
        <div class="lp-trust-stats-grid">
        <div class="lp-trust-stat">
          <h3>
            <span class="lp-trust-stat-number">98%</span>
            <span class="lp-trust-stat-label">of jobs finished</span>
          </h3>
          <p class="lp-trust-stat-desc">226 errands, each run three times.</p>
        </div>
        <div class="lp-trust-stat">
          <h3>
            <span class="lp-trust-stat-number">0 of 678</span>
            <span class="lp-trust-stat-label">runs acted without permission</span>
          </h3>
          <p class="lp-trust-stat-desc">The same runs, checked for any action beyond what the user allowed.</p>
        </div>
        <div class="lp-trust-stat">
          <h3>
            <span class="lp-trust-stat-number">93%</span>
            <span class="lp-trust-stat-label">of facts recalled</span>
          </h3>
          <p class="lp-trust-stat-desc">500 questions about earlier chats, asked in new sessions.</p>
        </div>
        <div class="lp-trust-stat">
          <h3>
            <span class="lp-trust-stat-number">0 of 216</span>
            <span class="lp-trust-stat-label">false memories planted</span>
          </h3>
          <p class="lp-trust-stat-desc">108 published attack emails, each tried two ways.</p>
        </div>
      </div>
      </section>

      <section class="lp-hard-ones-heading">
        <div class="lp-hard-ones-frame wide with-sub lp-dot-grid-bg">
          <h2>On your machine, on your word</h2>
          <p class="lp-hard-ones-sub">It gets on with the work, and asks before it speaks for you.</p>
        </div>
      </section>

      <div class="lp-stack">
        <div class="lp-pillar">
          <div class="lp-claim">
            <h3 class="lp-claim-heading">Walk into every call prepared</h3>
            <div class="lp-claim-body">
              <p class="lp-claim-paragraph">
                Every morning, Nod reads your threads, your calendar and the client's latest news, and writes a one-page brief
                for each call.
              </p>
              <p class="lp-claim-paragraph">
                Nod stores the brief on the computer or server that runs it. Your model service receives the information needed for the task.
              </p>
            </div>
          </div>
          <div class="lp-panel-photo">
            <Picture src={briefCollage} {...photo} widths={[640, 960, 1280, 1616]} sizes={panelSizes} loading="lazy" />
            <div class="overlay"></div>
            <div class="lp-panel">
              <div class="nod-screen nod-brief-screen">
                <div class="nod-chat">
                  <div class="nod-msg" data-at="0">
                    <div class="nod-bubble">
                      <div class="nod-text"><p>Your brief for Brightline is ready.</p></div>
                      <div class="nod-attachment" data-at="1150" data-until="1800">
                        <svg width="24" height="24" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"
                          ><path d="M14.75 15.25H1.25V.75h13.5zm-12-1.5h10.5V2.25H2.75zm8-3.25h-5.5V9h5.5zm0-3.5h-5.5V5.5h5.5z"
                          ></path></svg
                        >
                        <svg class="nod-cursor" data-at="400" viewBox="0 0 24 24" aria-hidden="true"
                          ><path d="M5 2.5v17l4.4-4.1 2.9 6.3 2.7-1.2-2.9-6.2 6-.3z"></path></svg
                        >
                        <span class="nod-attachment-text"
                          ><span class="nod-attachment-name">Brightline Studio – call brief.pdf</span><span
                            class="nod-attachment-meta">PDF · 1 page · 40 KB</span
                          ></span
                        >
                      </div>
                    </div>
                  </div>
                </div>
                <article class="brief" data-at="1400">
                  <div class="brief-kicker">Call brief</div>
                  <div class="brief-title">Brightline Studio</div>
                  <div class="brief-meta">Tuesday, 27 October 2026 · 11:00–11:30 · Sara Kim, producer</div>
                  <div class="brief-heading">Where things stand</div>
                  <div class="brief-box">
                    <p>
                      Sara wants 3 short videos for the Brightline launch. She asked about pricing in Slack last week and is
                      waiting on an answer.
                    </p>
                  </div>
                  <div class="brief-heading">From your last emails</div>
                  <ul>
                    <li>Launch date moved to 20 November.</li>
                    <li>They liked the cut-down format of the September reel.</li>
                    <li>Brand assets folder still to be shared.</li>
                  </ul>
                  <div class="brief-heading">Their latest news</div>
                  <ul>
                    <li>New pricing page: 3 plans from $1,200.</li>
                    <li>Opened a second studio in Lisbon.</li>
                  </ul>
                  <div class="brief-heading">Ask on the call</div>
                  <ul>
                    <li>Deadline for the first cut?</li>
                    <li>Who signs off on scripts?</li>
                    <li>Budget range for 3 videos?</li>
                  </ul>
                </article>
              </div>
            </div>
          </div>
        </div>

        <div class="lp-pillar">
          <div class="lp-claim">
            <h3 class="lp-claim-heading">Catch the question you missed</h3>
            <div class="lp-claim-body">
              <p class="lp-claim-paragraph">
                Nod finds the question you never answered, like a client's pricing ask from last week, and drafts the reply
                from your own pricing sheet.
              </p>
              <p class="lp-claim-paragraph">
                You decide what it may send. Nod checks each action against your request and rules, and asks when they don't cover it.
              </p>
            </div>
          </div>
          <div class="lp-panel-photo">
            <Picture src={replyCollage} {...photo} widths={[640, 1024]} sizes={panelSizes} loading="lazy" />
            <div class="overlay"></div>
            <div class="lp-panel">
              <div class="nod-screen nod-slack-screen">
                <div class="nod-chat">
                  <div class="nod-msg">
                    <div class="nod-bubble" data-at="0">
                      <div class="nod-text">
                        <p>
                          Also: Sara asked in Slack last week, <mark class="nod-mark" data-at="600" data-until="2500"
                            ><strong>“What would pricing look like for 3 videos?”</strong></mark
                          > and it was never answered. I pulled your pricing sheet from Notion and drafted a reply:
                        </p>
                        <blockquote>
                          <p>
                            Hi Sara! For three launch videos it’s <strong>$3,600</strong> ($1,200 each), first cuts in 10 working days. Happy
                            to walk you through it on a call.
                          </p>
                        </blockquote>
                        <p>Reply to Sara in Slack?</p>
                      </div>
                    </div>
                  </div>
                  <div class="nod-msg is-you" data-at="1500">
                    <div class="nod-bubble"><div class="nod-text"><p>Yes, reply</p></div></div>
                  </div>
                  <div class="nod-msg nod-msg-slot">
                    <div class="nod-working" data-at="2000" data-until="2500" aria-hidden="true">
                      <svg viewBox="0 0 32 32" fill="none" aria-hidden="true"
                        ><circle cx="16" cy="16" r="10" stroke="currentColor" stroke-width="4"></circle><g class="nod-orbit"
                          ><circle cx="25" cy="6" r="4" fill="var(--nod-pink)"></circle></g
                        ></svg
                      >
                      <span class="nod-working-steps">
                        <span data-at="2000" data-until="2500">Nodding along…</span>
                      </span>
                    </div>
                    <div class="nod-bubble" data-at="2500">
                      <div class="nod-text"><p>Replied in Slack <span class="nod-emoji" data-at="2650">✅</span></p></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="lp-pillar">
          <div class="lp-claim">
            <h3 class="lp-claim-heading">Hear about it when it matters</h3>
            <div class="lp-claim-body">
              <p class="lp-claim-paragraph">
                Tell Nod to keep an eye on a client's pricing page. It checks every few hours and only speaks up when
                something changes.
              </p>
              <p class="lp-claim-paragraph">Each check uses the model service you choose. Nod shows estimated model costs in Usage.</p>
            </div>
          </div>
          <div class="lp-panel-photo">
            <Picture src={watchCollage} {...photo} widths={[640, 960, 1280, 1616]} sizes={panelSizes} loading="lazy" />
            <div class="overlay"></div>
            <div class="lp-panel">
              <div class="nod-screen nod-watch-screen">
                <div class="mac-note" data-at="500" role="img" aria-label="Notification from Nod: Brightline pricing changed">
                  <div class="mac-note-icon">
                    <svg viewBox="0 0 32 32" fill="none" aria-hidden="true"
                      ><circle cx="16" cy="16" r="10" stroke="currentColor" stroke-width="4"></circle><circle
                        cx="25"
                        cy="6"
                        r="4"
                        fill="var(--nod-pink)"></circle></svg
                    >
                  </div>
                  <div class="mac-note-body">
                    <div class="mac-note-head"><b>Nod</b><small>now</small></div>
                    <span>Brightline pricing changed: 3 plans from $1,500, was $1,200.</span>
                  </div>
                </div>
                <article class="nod-plan">
                  <div class="nod-plan-title">
                    <div class="nod-plan-name">Brightline pricing page</div>
                    <span class="nod-plan-status">Recurring</span>
                    <span class="nod-switch" aria-hidden="true"><span></span></span>
                  </div>
                  <p class="nod-plan-meta">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"
                      ><path
                        d="M6.25 2.75h3.5V.25h1.5v2.5h4V15H.75V2.75h4V.25h1.5zm-4 10.75h11.5V4.25h-2.5v2.5h-1.5v-2.5h-3.5v2.5h-1.5v-2.5h-2.5z"
                      ></path></svg
                    >
                    <span>Every 6 hours</span><span>Next 27 Oct, 12:00</span>
                  </p>
                  <div class="nod-plan-details">
                    <p class="nod-plan-description">
                      Check brightline.studio/pricing and tell me when their plans or prices change
                    </p>
                    <p class="nod-plan-note">Baseline: 3 plans from $1,200 · 26 Oct, 18:00</p>
                  </div>
                  <div class="nod-plan-footer">
                    <span class="nod-btn nod-plan-more"
                      >Hide details<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"
                        ><path d="M15.56 5.25 8 12.81.44 5.25 1.5 4.19l6.5 6.5 6.5-6.5z"></path></svg
                      ></span
                    >
                    <span class="nod-plan-actions">
                      <span class="nod-btn nod-btn-filled"
                        ><svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"
                          ><path
                            d="m15.81 5.75-9.5 9.5H.75V9.69l9.5-9.5zm-13.56 8h2.99a3.25 3.25 0 0 0-1.996-2.753 3.3 3.3 0 0 0-.994-.237zm.914-4.354a4.75 4.75 0 0 1 3.225 2.787q.13.319.215.652l3.632-3.634a3.8 3.8 0 0 0-.271-1.137 3.75 3.75 0 0 0-3.168-2.302zM8.07 4.49a5.25 5.25 0 0 1 2.143 1.298A5.25 5.25 0 0 1 11.51 7.93l2.18-2.18-3.439-3.44z"
                          ></path></svg
                        >Edit schedule</span
                      >
                      <span class="nod-btn"
                        ><svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"
                          ><path
                            d="M6.474 1.106c.562-1.36 2.49-1.36 3.051 0l1.567 3.8 3.801 1.568c1.361.562 1.361 2.49 0 3.051l-3.8 1.567-1.568 3.801c-.561 1.361-2.49 1.361-3.05 0l-1.57-3.8-3.799-1.568c-1.36-.562-1.36-2.490 0-3.05l3.8-1.569zM8 1.585a.16.16 0 0 0-.084.022.14.14 0 0 0-.055.07l-1.686 4.09-.12.288-.288.12-4.09 1.686a.14.14 0 0 0-.07.055.16.16 0 0 0-.022.084q.002.052.022.084c.01.017.03.038.07.054l4.09 1.687.288.12.12.287 1.686 4.09a.14.14 0 0 0 .055.07.16.16 0 0 0 .084.023.16.16 0 0 0 .084-.023.14.14 0 0 0 .054-.07l1.687-4.09.119-.288.288-.12 4.09-1.686a.14.14 0 0 0 .07-.054.16.16 0 0 0 .023-.084.16.16 0 0 0-.023-.084.14.14 0 0 0-.07-.055l-4.09-1.686-.288-.12-.12-.288-1.686-4.090a.14.14 0 0 0-.054-.07A.16.16 0 0 0 8 1.585"
                          ></path></svg
                        >Ask Nod</span
                      >
                      <span class="nod-btn nod-btn-icon" aria-hidden="true"
                        ><svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"
                          ><path
                            d="M3.25 13.75h9.5V6.5h1.5v8.75H1.75V6.5h1.5zm3.6-2.5h-1.5V6.5h1.5zm3.8 0h-1.5V6.5h1.5zm-1.9-8.5h6.5v1.5H.75v-1.5h6.5V.25h1.5z"
                          ></path></svg
                        ></span
                      >
                    </span>
                  </div>
                </article>
              </div>
            </div>
          </div>
        </div>
      </div>

      <section class="lp-split">
        <div class="lp-split-intro">
          <div class="lp-hard-ones-frame lp-dot-grid-bg">
            <h2>A memory like an elephant</h2>
          </div>
