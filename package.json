{
  "name": "otto",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "node scripts/start.mjs",
    "dev:server": "tsx watch src/server/index.ts",
    "desktop:dev": "node desktop/scripts/build-ui.mjs && pnpm --dir desktop start",
    "desktop:prepare": "node desktop/scripts/prepare-runtime.mjs",
    "desktop:build": "pnpm --dir desktop run build",
    "desktop:windows:prepare": "node desktop/scripts/prepare-windows-runtime.mjs",
    "desktop:windows:build": "node desktop/scripts/build-windows.mjs",
    "desktop:test": "pnpm --dir desktop test",
    "build": "tsc --noEmit && vite build && node desktop/scripts/build-ui.mjs",
    "check": "pnpm run lint && pnpm run format:check",
    "lint": "tsc --noEmit && node scripts/check-architecture.mjs",
    "test": "tsx --test tests/*.test.ts",
    "start": "node scripts/start.mjs --production",
    "test:integration": "node scripts/test-integration.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eval:voice": "tsx scripts/voice-eval.ts",
    "eval:capability": "tsx evals/src/cli.ts"
  },
