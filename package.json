{
  "name": "otto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "node scripts/start.mjs",
    "dev:server": "tsx watch src/server/index.ts",
    "desktop:dev": "node desktop/scripts/build-ui.mjs && npm --prefix desktop start",
    "desktop:prepare": "node desktop/scripts/prepare-runtime.mjs",
    "desktop:build": "npm --prefix desktop run build",
    "desktop:test": "npm --prefix desktop test",
    "build": "tsc --noEmit && vite build && node desktop/scripts/build-ui.mjs",
    "check": "tsc --noEmit && node scripts/check-architecture.mjs && node scripts/check-images.mjs && npm run format:check",
    "test": "tsx --test tests/*.test.ts",
    "start": "node scripts/start.mjs --production",
    "test:integration": "node scripts/test-integration.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eval:voice": "tsx scripts/voice-eval.ts",
    "eval:capability": "tsx evals/src/cli.ts"
  },
  "dependencies": {
