FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 python-is-python3 python3-pip python3-venv pipx ffmpeg ca-certificates curl git unzip && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /workspace /home/node/.local/bin && chown -R node:node /workspace /home/node
RUN groupadd --gid 1002 otto-connected && useradd --uid 1002 --gid 1002 --create-home --shell /usr/sbin/nologin otto-connected && chmod 700 /home/otto-connected
USER node
ENV NPM_CONFIG_PREFIX=/home/node/.local
ENV PIPX_HOME=/home/node/.local/pipx
ENV PIPX_BIN_DIR=/home/node/.local/bin
ENV PATH=/home/node/.local/bin:$PATH
WORKDIR /workspace
